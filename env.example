# ELK Stack with ElastiFlow - Environment Configuration
# Copy to .env and customize

# ============================================================
# ELASTICSEARCH CLUSTER
# ============================================================
CLUSTER_NAME=flow-monitoring-cluster
STACK_VERSION=8.16.0
LICENSE=basic
MEM_LIMIT=4g

# ============================================================
# SECURITY (CHANGE THESE BEFORE DEPLOYMENT!)
# ============================================================
ELASTIC_PASSWORD=your-secure-elastic-password
KIBANA_PASSWORD=your-secure-kibana-password

# Generate with: openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=
KIBANA_SECURITY_KEY=
KIBANA_REPORTING_KEY=

# ============================================================
# FRONTEND SERVER (Elasticsearch + Kibana)
# ============================================================
FRONTEND_IP=10.0.0.10
ES_PORT=9200
KIBANA_PORT=5601

# ============================================================
# ELASTICSEARCH HOST (for ElastiFlow collectors)
# Usually the same as FRONTEND_IP
# ============================================================
ELASTICSEARCH_HOST=10.0.0.10:9200