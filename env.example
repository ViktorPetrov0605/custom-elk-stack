# ELK Stack Deployment Configuration
# Copy this file to .env and customize for your environment

# ============================================================
# SECURITY (CHANGE THESE!)
# ============================================================
ELASTIC_PASSWORD=your-secure-password-here
KIBANA_PASSWORD=your-kibana-password-here

# Generate encryption keys with: openssl rand -base64 32
KIBANA_ENCRYPTION_KEY=
KIBANA_SECURITY_KEY=
KIBANA_REPORTING_KEY=

# ============================================================
# STACK CONFIGURATION
# ============================================================
STACK_VERSION=9.2.4
CLUSTER_NAME=netflow-cluster
LICENSE=basic
MEM_LIMIT=4294967296

# ============================================================
# NETWORKING - Frontend (Kibana + Elasticsearch)
# ============================================================
FRONTEND_IP=10.4.4.87
ES_PORT=9200
KIBANA_PORT=5601

# ============================================================
# NETWORKING - Backend (Logstash Collectors)
# Comma-separated list of all backend IPs
# ============================================================
BACKEND_IP=10.4.4.21,10.4.4.90