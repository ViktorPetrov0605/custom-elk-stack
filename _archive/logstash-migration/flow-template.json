{
  "index_patterns": ["logstash-flow-*"],
  "template": {
    "settings": {
      "number_of_shards": 2,
      "number_of_replicas": 1,
      "index.lifecycle.name": "flow-data-3-day",
      "index.lifecycle.rollover_alias": "logstash-flow"
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        {
          "ip_fields": {
            "match": "*ip",
            "mapping": {
              "type": "ip"
            }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "@version": { "type": "keyword" },
        
        "host": {
          "properties": {
            "ip": { "type": "ip" },
            "name": { "type": "keyword" }
          }
        },
        
        "source": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "integer" },
            "bytes": { "type": "long" },
            "packets": { "type": "long" },
            "mac": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "as": {
              "properties": {
                "number": { "type": "integer" },
                "organization": {
                  "properties": {
                    "name": { "type": "keyword" }
                  }
                }
              }
            },
            "geo": {
              "properties": {
                "city_name": { "type": "keyword" },
                "country_name": { "type": "keyword" },
                "country_iso_code": { "type": "keyword" },
                "region_name": { "type": "keyword" },
                "location": { "type": "geo_point" }
              }
            },
            "locality": { "type": "keyword" }
          }
        },
        
        "destination": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "integer" },
            "bytes": { "type": "long" },
            "packets": { "type": "long" },
            "mac": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "as": {
              "properties": {
                "number": { "type": "integer" },
                "organization": {
                  "properties": {
                    "name": { "type": "keyword" }
                  }
                }
              }
            },
            "geo": {
              "properties": {
                "city_name": { "type": "keyword" },
                "country_name": { "type": "keyword" },
                "country_iso_code": { "type": "keyword" },
                "region_name": { "type": "keyword" },
                "location": { "type": "geo_point" }
              }
            },
            "locality": { "type": "keyword" }
          }
        },
        
        "client": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "integer" },
            "mac": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "as": {
              "properties": {
                "number": { "type": "integer" },
                "organization": {
                  "properties": {
                    "name": { "type": "keyword" }
                  }
                }
              }
            }
          }
        },
        
        "server": {
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "integer" },
            "mac": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "as": {
              "properties": {
                "number": { "type": "integer" },
                "organization": {
                  "properties": {
                    "name": { "type": "keyword" }
                  }
                }
              }
            }
          }
        },
        
        "network": {
          "properties": {
            "bytes": { "type": "long" },
            "packets": { "type": "long" },
            "transport": { "type": "keyword" },
            "iana_number": { "type": "keyword" },
            "direction": { "type": "keyword" },
            "protocol": { "type": "keyword" },
            "type": { "type": "keyword" }
          }
        },
        
        "flow": {
          "properties": {
            "id": { "type": "keyword" },
            "sample": {
              "properties": {
                "rate": { "type": "integer" }
              }
            },
            "export": {
              "properties": {
                "version": {
                  "properties": {
                    "name": { "type": "keyword" },
                    "ver": { "type": "integer" }
                  }
                }
              }
            },
            "locality": { "type": "keyword" }
          }
        },
        
        "observer": {
          "properties": {
            "ingress": {
              "properties": {
                "interface": {
                  "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "keyword" }
                  }
                }
              }
            },
            "egress": {
              "properties": {
                "interface": {
                  "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "keyword" }
                  }
                }
              }
            }
          }
        },
        
        "event": {
          "properties": {
            "category": { "type": "keyword" },
            "type": { "type": "keyword" },
            "kind": { "type": "keyword" },
            "dataset": { "type": "keyword" },
            "module": { "type": "keyword" },
            "sequence": { "type": "long" }
          }
        },
        
        "agent": {
          "properties": {
            "type": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        
        "ecs": {
          "properties": {
            "version": { "type": "keyword" }
          }
        },
        
        "ip": {
          "properties": {
            "tos": { "type": "integer" },
            "ttl": { "type": "integer" },
            "dscp": {
              "properties": {
                "name": { "type": "keyword" }
              }
            }
          }
        },
        
        "tcp": {
          "properties": {
            "flags": { "type": "integer" }
          }
        },
        
        "vlan": {
          "properties": {
            "id": { "type": "integer" }
          }
        }
      }
    }
  }
}