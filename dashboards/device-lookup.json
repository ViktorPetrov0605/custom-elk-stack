  "lookupEntries": [
    {"key": "192.168.XX.21", "value": "DEVICE_NAME_1"},
    {"key": "192.168.XX.22", "value": "DEVICE_NAME_2"},
    {"key": "192.168.XX.25", "value": "DEVICE_NAME_3"},
    {"key": "192.168.XX.26", "value": "DEVICE_NAME_4"},
    {"key": "192.168.XX.27", "value": "DEVICE_NAME_5"},
    {"key": "192.168.XX.28", "value": "DEVICE_NAME_6"}
  ]
}
