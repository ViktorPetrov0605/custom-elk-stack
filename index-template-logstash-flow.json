{
  "index_patterns": ["logstash-flow-*"],
  "template": {
    "settings": {
      "index": {
        "lifecycle": {
          "name": "logstash-flow-policy"
        },
        "number_of_shards": "1",
        "number_of_replicas": "0"
      }
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "destination": {
          "properties": {
            "port": { "type": "integer" },
            "bytes": { "type": "long" },
            "ip": { "type": "ip" },
            "packets": { "type": "long" }
          }
        },
        "source": {
          "properties": {
            "port": { "type": "integer" },
            "bytes": { "type": "long" },
            "ip": { "type": "ip" },
            "packets": { "type": "long" }
          }
        },
        "network": {
          "properties": {
            "bytes": { "type": "long" },
            "transport": { "type": "keyword" },
            "packets": { "type": "long" }
          }
        }
      }
    }
  },
  "priority": 200
}
