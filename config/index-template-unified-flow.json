{
  "index_patterns": ["unified-flow-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "flow-data-1-day-retention",
      "index.lifecycle.rollover_alias": "unified-flow",
      "index.mapping.total_fields.limit": 1000
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "event": {
          "properties": {
            "type": {
              "type": "keyword"
            }
          }
        },
        "device": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "ip": {
              "type": "ip"
            },
            "type": {
              "type": "keyword"
            }
          }
        },
        "observer": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "ip": {
              "type": "ip"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "integer"
            },
            "as": {
              "properties": {
                "number": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "integer"
            },
            "as": {
              "properties": {
                "number": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "network": {
          "properties": {
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            },
            "transport": {
              "type": "keyword"
            },
            "iana_number": {
              "type": "keyword"
            },
            "direction": {
              "type": "keyword"
            },
            "protocol": {
              "type": "keyword"
            }
          }
        },
        "interface": {
          "properties": {
            "input": {
              "type": "integer"
            },
            "output": {
              "type": "integer"
            }
          }
        },
        "sampling": {
          "properties": {
            "rate": {
              "type": "integer"
            },
            "algorithm": {
              "type": "integer"
            }
          }
        },
        "flow": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}